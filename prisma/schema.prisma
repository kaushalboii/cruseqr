// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  name            String
  avatar          String?
  role            String         @default("USER") // USER, ADMIN
  isEmailVerified Boolean        @default(true)
  plan            String         @default("FREE") // FREE, PRO, BUSINESS, ENTERPRISE
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  qrCodes         QrCode[]
  projects        Project[]
  folders         Folder[]
  bioPages        LinkInBioPage[]
  businessCards   DigitalBusinessCard[]
  aiGenerations   AiQrGeneration[]
  subscriptions   Subscription[]
  auditLogs       AuditLog[]
}

model Project {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String    @default("#8B5CF6")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  folders     Folder[]
  qrCodes     QrCode[]
}

model Folder {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  qrCodes     QrCode[]
}

model QrCode {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  folderId        String?
  folder          Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  
  title           String
  description     String?
  qrType          String        @default("URL") // URL, TEXT, EMAIL, PHONE, SMS, WHATSAPP, WIFI, VCARD, LOCATION, EVENT, PDF, SOCIAL, APP, PAYMENT, BIO, MULTI
  isDynamic       Boolean       @default(true)
  shortCode       String        @unique // unique redirect slug (e.g. "abc123xy")
  destinationUrl  String?
  contentData     String        // JSON encoded content data
  designConfig    String        // JSON encoded visual styling parameters
  status          String        @default("ACTIVE") // ACTIVE, PAUSED, EXPIRED
  expiresAt       DateTime?
  password        String?       // Optional password for access
  totalScans      Int           @default(0)
  uniqueScans     Int           @default(0)
  tags            String?       // comma separated tags
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  scans           QrScan[]
  bioPages        LinkInBioPage[]
  businessCards   DigitalBusinessCard[]
}

model QrScan {
  id          String    @id @default(cuid())
  qrCodeId    String
  qrCode      QrCode    @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  timestamp   DateTime  @default(now())
  ipHash      String?   // Anonymized SHA256 of IP for unique count without privacy leak
  userAgent   String?
  deviceType  String?   // mobile, desktop, tablet, bot
  os          String?   // iOS, Android, macOS, Windows, Linux, etc.
  browser     String?   // Chrome, Safari, Firefox, Edge, etc.
  country     String?
  region      String?
  city        String?
  referer     String?
}

model LinkInBioPage {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String      @unique // for /bio/[username]
  title       String
  bio         String?
  avatarUrl   String?
  bannerUrl   String?
  theme       String      @default("cosmic") // cosmic, obsidian, aurora, emerald, sunset, minimal
  buttonStyle String      @default("rounded") // rounded, sharp, pill, glow
  qrCodeId    String?
  qrCode      QrCode?     @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  views       Int         @default(0)
  isActive    Boolean     @default(true)
  socialLinks String?     // JSON string of social media handles
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  links       LinkItem[]
}

model LinkItem {
  id          String        @id @default(cuid())
  bioPageId   String
  bioPage     LinkInBioPage @relation(fields: [bioPageId], references: [id], onDelete: Cascade)
  title       String
  url         String
  icon        String?
  type        String        @default("LINK") // LINK, HEADER, SOCIAL, CONTACT
  order       Int           @default(0)
  clicks      Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model DigitalBusinessCard {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String    @unique // for /card/[slug]
  fullName    String
  jobTitle    String?
  company     String?
  email       String
  phone       String?
  website     String?
  address     String?
  bio         String?
  avatarUrl   String?
  bannerColor String    @default("#8B5CF6")
  qrCodeId    String?
  qrCode      QrCode?   @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  views       Int       @default(0)
  saves       Int       @default(0)
  socials     String?   // JSON string of social links
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AiQrGeneration {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt            String
  stylePreset       String    // Cyberpunk, Anime, Nature, Architecture, Luxury, etc.
  destinationUrl    String
  qrData            String
  resultImageUrl    String?
  scannabilityScore Float     @default(95.0)
  status            String    @default("COMPLETED") // COMPLETED, PENDING, FAILED
  parameters        String?   // JSON configuration
  createdAt         DateTime  @default(now())
}

model Template {
  id           String    @id @default(cuid())
  title        String
  category     String    // RESTAURANT, RETAIL, EVENT, PERSONAL, MARKETING, EDUCATION, HEALTHCARE, HOSPITALITY, BUSINESS, SOCIAL
  description  String
  qrType       String    @default("URL")
  designConfig String    // JSON encoded styling
  previewColor String    @default("#8B5CF6")
  isFeatured   Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String    @default("FREE") // FREE, PRO, BUSINESS, ENTERPRISE
  status               String    @default("ACTIVE") // ACTIVE, CANCELED, PAST_DUE
  currentPeriodStart   DateTime  @default(now())
  currentPeriodEnd     DateTime
  stripeCustomerId     String?
  stripeSubscriptionId String?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model AuditLog {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime  @default(now())
}

