# CruseQR Configuration

# Database
# For SQLite (default local development):
DATABASE_URL="file:./dev.db"
# For PostgreSQL (production):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/cruseqr?schema=public"

# Authentication
JWT_SECRET="cruseqr_ultra_secure_jwt_secret_token_change_in_production_32char"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI QR Art Generation
# Options: "mock" (default built-in high quality SVG/canvas synthesis), "stability", "replicate", "openai"
AI_PROVIDER="mock"
AI_API_KEY=""

# Stripe Payment & Billing (Optional for production subscription webhooks)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

